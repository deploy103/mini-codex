# Copy this file to .env and fill in the keys your APIM/OpenAI gateway provides.
APIM_KEY=
APIM_BASE_URL=
CHAT_MODEL=gpt-5-codex
EMBEDDING_MODEL=
VISION_MODEL=

# OpenAI-native aliases are also supported.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5-codex

# Optional: responses, chat, foundry_models, azure_v1, azure_chat, or auto.
# auto tries common OpenAI, APIM, Foundry Models, and Azure OpenAI routes.
OPENAI_API_MODE=auto

# Optional request timeout in seconds.
APIM_TIMEOUT=180

# Optional for Azure deployment-style API fallback.
# AZURE_OPENAI_API_VERSION=2024-10-21

# For this APIM Foundry Proxy format, APIM_BASE_URL should stop at /foundry.
# The app automatically calls: {APIM_BASE_URL}/{CHAT_MODEL}/responses

# Optional: if your APIM gateway wants the key in a custom header instead of
# Authorization: Bearer <key>, set the header name here.
# Example: APIM_KEY_HEADER=Ocp-Apim-Subscription-Key
# APIM_KEY_HEADER=
